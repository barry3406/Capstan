{
  "name": "@zauso-ai/capstan-ai",
  "version": "0.5.10",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./kernel": {
      "import": "./dist/harness/kernel/index.js",
      "types": "./dist/harness/kernel/index.d.ts"
    },
    "./kernel/*": {
      "import": "./dist/harness/kernel/*/index.js",
      "types": "./dist/harness/kernel/*/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.kernel.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "description": "AI agent toolkit — think, generate, memory, agent loop. Works standalone or with Capstan.",
  "license": "MIT",
  "author": "barry3406",
  "publishConfig": {
    "access": "public"
  }
}
